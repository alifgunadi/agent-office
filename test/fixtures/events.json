[
  {
    "name": "claude-code via hook.js (envelope v1)",
    "payload": { "v": 1, "source": "claude-code", "hook_event_name": "PreToolUse", "session_id": "s-claude", "tool_name": "Edit", "tool_input": { "file_path": "server.js" } },
    "expect": { "desk": "main", "status": "working", "activity": "Edit server.js" }
  },
  {
    "name": "claude-code before the envelope existed",
    "payload": { "hook_event_name": "PreToolUse", "session_id": "s-old", "tool_name": "Grep", "tool_input": { "pattern": "todo" } },
    "expect": { "desk": "main", "status": "working", "activity": "Grep \"todo\"" }
  },
  {
    "name": "antigravity adapter as installed before this repo shipped it (full path, no envelope)",
    "payload": { "hook_event_name": "PreToolUse", "session_id": "conv-1", "tool_name": "view_file", "tool_input": { "file_path": "C:\\Users\\bob\\proj\\src\\a.js" } },
    "expect": { "desk": "main", "status": "working", "activity": "view_file a.js" }
  },
  {
    "name": "opencode plugin as installed before this repo shipped it (100-char pattern, no envelope)",
    "payload": { "hook_event_name": "PreToolUse", "session_id": "ses_1", "tool_name": "grep", "tool_input": { "pattern": "abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789abcdefghijklmnopqrstuvwxyz" } },
    "expect": { "desk": "main", "status": "working", "activity": "grep \"abcdefghijklmnopqrstuvwxyz0123456789ABCD\"" }
  },
  {
    "name": "subagent start with a nested agent type",
    "payload": { "v": 1, "source": "opencode", "hook_event_name": "SubagentStart", "session_id": "ses_1", "agent_id": "task-1", "agent_type": "engineering/lead-dba" },
    "expect": { "desk": "lead-dba", "status": "working", "activity": "starting task" }
  },
  {
    "name": "notification that blocks on the user",
    "payload": { "hook_event_name": "Notification", "session_id": "s", "notification_type": "agent_needs_input" },
    "expect": { "desk": "main", "status": "waiting", "activity": "waiting for your input" }
  },
  {
    "name": "turn ended on an API error",
    "payload": { "hook_event_name": "StopFailure", "session_id": "s", "error": "rate_limit", "last_assistant_message": "SECRET text" },
    "expect": { "desk": "main", "status": "done", "activity": "turn failed" }
  },
  {
    "name": "a future sender adds fields and a newer version",
    "payload": { "v": 7, "source": "new-agent", "hook_event_name": "UserPromptSubmit", "session_id": "s", "prompt": "SECRET prompt", "extra": { "a": 1 } },
    "expect": { "desk": "main", "status": "working", "activity": "thinking..." }
  }
]
